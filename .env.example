# POST every chat / form request (appointments, call backs, questions) as JSON to this URL.
# Works with your own API, a CRM webhook, Zapier/Make, Formspree, etc.
# Leave unset to run in demo mode (requests are kept in the browser's localStorage).
VITE_REQUEST_ENDPOINT=

# ---------- Backend server (reviews, blog, staff logins) ----------
# Port the Node server listens on (npm run dev:api / npm start)
PORT=3001
# Where the SQLite database and uploaded images are stored. Back this folder up.
# DATA_DIR=./server/data
# The owner's admin account is created from these on the very first start.
ADMIN_NAME=Clinic Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Booking emails (optional) ----------
# Email the clinic whenever someone books or sends a request on the website.
# Gmail: turn on 2-Step Verification, create an "App password" and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Who receives the emails (defaults to SMTP_USER)
NOTIFY_EMAIL=themirrorsdermatologyclinic@gmail.com
# The live website address, used for the "open the staff area" link in emails
SITE_URL=https://themirrorsdermclinic.com

# ---------- Google rating & reviews (optional) ----------
# Google Cloud → enable "Places API (New)" → create an API key (restrict it to that API).
# Shows the clinic's live Google rating, review count and latest reviews on the Reviews page.
GOOGLE_PLACES_API_KEY=
# Optional — found automatically from the clinic name on first run (printed in the server log)
GOOGLE_PLACE_ID=
