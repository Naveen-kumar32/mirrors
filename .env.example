# POST every chat / form request (appointments, call backs, questions) as JSON to this URL.
# Works with your own API, a CRM webhook, Zapier/Make, Formspree, etc.
# Leave unset to run in demo mode (requests are kept in the browser's localStorage).
VITE_REQUEST_ENDPOINT=

# ---------- Backend server (reviews, blog, staff logins) ----------
# Port the Node server listens on (npm run dev:api / npm start)
PORT=3001
# Where the SQLite database and uploaded images are stored. Back this folder up.
# DATA_DIR=./server/data
# The owner's admin account is created from these on the very first start.
ADMIN_NAME=Clinic Owner
ADMIN_EMAIL=
ADMIN_PASSWORD=
